{% comment %}
  Order status snippet — multiple lx-if patterns for fulfillment messaging.
{% endcomment %}

<div class="order-status" data-order-id="{{ order.id }}">
  <h2>Order {{ order.name }}</h2>

  <p class="order-status__fulfillment">
    {% lx-if order.fulfillment_status == "fulfilled" "Your order has shipped" "We're preparing your order" %}
  </p>

  <p class="order-status__payment">
    {% lx-if order.financial_status == "paid" "Payment received" "Payment pending" %}
  </p>

  {% if order.cancelled %}
    <p class="order-status__cancelled">This order was cancelled.</p>
  {% endif %}

  <ul class="order-status__items">
    {% for line_item in order.line_items %}
      <li>
        {{ line_item.title }} × {{ line_item.quantity }}
      </li>
    {% endfor %}
  </ul>
</div>
